generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  STAFF
}

enum CalculateRequestStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)

  lastLoginAt DateTime?

  sessions AdminSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}


model AdminSession {
  id Int @id @default(autoincrement())

  userId Int
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash     String @unique
  csrfTokenHash String

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  ipAddress String @default("")
  userAgent String @default("")

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ProductCategory {
  id Int @id @default(autoincrement())

  name        String
  slug        String @unique
  description String @default("")
  imagePath   String @default("")

  seoTitle       String @default("")
  seoDescription String @default("")

  products Product[]

  sortOrder   Int     @default(100)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model Product {
  id Int @id @default(autoincrement())

  title String
  slug  String @unique

  shortDescription String @default("")
  description      String @default("")

  unit       String
  dimensions String @default("")
  purpose    String @default("")

  seoTitle       String @default("")
  seoDescription String @default("")

  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  isPublished Boolean @default(false)
  sortOrder   Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isPublished, sortOrder])
  @@index([createdAt])
}

model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name String  @default("Стандарт")
  sku  String? @unique

  color       String @default("")
  colorHex    String?
  thicknessMm Int?

  price Int

  isActive  Boolean @default(true)
  sortOrder Int     @default(100)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive, sortOrder])
  @@index([color])
  @@index([thicknessMm])
  @@index([price])
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imagePath String
  alt       String @default("")

  isMain    Boolean @default(false)
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isMain, sortOrder])
}

model CalculateRequest {
  id Int @id @default(autoincrement())

  name  String
  phone String

  area    Float?
  purpose String?

  comment  String  @default("")
  delivery Boolean @default(false)

  status          CalculateRequestStatus @default(NEW)
  internalComment String                 @default("")

  source String @default("website")

  dedupFingerprint String

  ipAddress String @default("")
  userAgent String @default("")

  consentAccepted   Boolean   @default(false)
  consentAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([dedupFingerprint, createdAt])
  @@index([source, createdAt])
  @@index([ipAddress])
  @@index([createdAt])
}

model Order {
  id Int @id @default(autoincrement())

  publicNumber   String @unique
  idempotencyKey String @unique

  status OrderStatus @default(NEW)

  customerName String
  phone        String
  comment      String @default("")

  fulfillmentMethod FulfillmentMethod @default(PICKUP)
  deliveryAddress   String            @default("")

  estimatedTotal Int  @default(0)
  confirmedTotal Int?

  confirmedAt DateTime?

  source String @default("catalog")

  consentAccepted   Boolean   @default(false)
  consentAcceptedAt DateTime?

  internalComment String @default("")

  ipAddress String @default("")
  userAgent String @default("")

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([source, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productTitleSnapshot String
  productSlugSnapshot  String

  variantNameSnapshot String @default("")
  skuSnapshot         String @default("")

  imagePathSnapshot  String @default("")
  unitSnapshot       String
  dimensionsSnapshot String @default("")

  colorSnapshot       String @default("")
  thicknessMmSnapshot Int?

  unitPriceSnapshot Int

  requestedQuantity Float  @default(1)
  requestedArea     Float?

  estimatedLineTotal Int @default(0)

  isAvailable Boolean?

  confirmedQuantity Float?
  confirmedArea     Float?

  confirmedUnitPrice Int?
  confirmedLineTotal Int?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}
